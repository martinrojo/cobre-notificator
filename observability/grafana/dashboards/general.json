{
  "uid": "general",
  "title": "General",
  "tags": [
    "cobre"
  ],
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "editable": false,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 8,
      "type": "alertlist",
      "title": "Alertas activas",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "options": {
        "viewMode": "list",
        "groupMode": "default",
        "groupBy": [],
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "alertInstanceLabelFilter": "",
        "showInstances": true,
        "stateFilter": {
          "firing": true,
          "pending": true,
          "noData": false,
          "normal": false,
          "error": true
        }
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Tasa de éxito",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(notificator_deliveries_total{outcome=\"delivered\"}[$__range])) / sum(increase(notificator_deliveries_total{outcome=~\"delivered|failed\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "description": "DELIVERED / (DELIVERED + FAILED) en el rango elegido. NOT_SUBSCRIBED y los intentos que se reintentan no cuentan.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Entregas por minuto",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 5,
        "y": 6,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(notificator_deliveries_total{outcome=\"delivered\"}[2m])) * 60",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Eventos al DLT (última hora)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 6,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(notificator_dlt_messages_total[1h]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Lag del notificator",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 6,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(kafka_consumergroup_uncommitted_offsets{consumergroup=\"notificator\"} >= 0)",
          "instant": true,
          "range": false
        }
      ],
      "description": "Mensajes sin consumir del grupo principal (transacciones y replays), medido en el broker. Los grupos de retry están en el dashboard Kafka.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Recovery job: eventos recuperados",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 6,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(notificator_recovery_events_total[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia p95: webhook y punta a punta",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(notificator_webhook_latency_seconds_bucket[5m])))",
          "legendFormat": "webhook"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(notificator_delivery_e2e_seconds_bucket[5m])))",
          "legendFormat": "punta a punta"
        }
      ],
      "description": "Punta a punta: de created_at del evento a DELIVERED, solo la primera generación (sin replays). Incluye los reintentos."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recovery job por acción",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (action) (increase(notificator_recovery_events_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 99,
      "type": "row",
      "title": "Plataforma",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 101,
          "type": "stat",
          "title": "Targets arriba",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 21,
            "w": 24,
            "h": 4
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "up{app=~\"manager|notificator\"}",
              "legendFormat": "{{app}}"
            }
          ]
        },
        {
          "id": 102,
          "type": "timeseries",
          "title": "Replays del manager",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 0,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "sum by (outcome) (rate(manager_replay_requests_total[5m]))",
              "legendFormat": "{{outcome}}"
            }
          ]
        },
        {
          "id": 103,
          "type": "timeseries",
          "title": "HTTP por status",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 12,
            "y": 25,
            "w": 12,
            "h": 8
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps"
            },
            "overrides": []
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "sum by (app, status) (rate(http_server_requests_seconds_count[5m]))",
              "legendFormat": "{{app}} {{status}}"
            }
          ]
        }
      ]
    }
  ]
}
