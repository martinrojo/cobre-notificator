{
  "uid": "jvm",
  "title": "JVM",
  "tags": [
    "cobre"
  ],
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_info, app)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(jvm_info, app)",
        "current": {
          "text": "manager",
          "value": "manager"
        },
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Resumen",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_uptime_seconds{app=\"$app\"}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Versión de la JVM",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jvm_info{app=\"$app\"}",
          "legendFormat": "{{version}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "name"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CPU del proceso",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_cpu_usage{app=\"$app\"}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Uso de CPU del proceso sobre todos los cores visibles para la JVM.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Heap después del GC",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jvm_memory_usage_after_gc{app=\"$app\", area=\"heap\", pool=\"long-lived\"}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Old Gen ocupada tras el último GC, sobre el máximo. Es el número de salud: si sube entre ciclos sin bajar, hay presión real o una fuga.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Memoria",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Heap usado vs máximo",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "max"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (id) (jvm_memory_used_bytes{app=\"$app\", area=\"heap\"})",
          "legendFormat": "{{id}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{app=\"$app\", area=\"heap\"} > 0)",
          "legendFormat": "max"
        }
      ],
      "description": "Pools de G1 apilados. El heap es fijo (-Xms = -Xmx), así que committed = max y no se grafica. G1 reporta -1 como máximo de Eden y Survivor: se filtran."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Non-heap por pool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (id) (jvm_memory_used_bytes{app=\"$app\", area=\"nonheap\"})",
          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Buffers",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (id) (jvm_buffer_memory_used_bytes{app=\"$app\"})",
          "legendFormat": "{{id}}"
        }
      ],
      "description": "Memoria fuera del heap de los buffers direct y mapped (clientes de Kafka, NIO)."
    },
    {
      "id": 10,
      "type": "row",
      "title": "GC",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pausas por segundo por causa",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cause) (rate(jvm_gc_pause_seconds_count{app=\"$app\"}[2m]))",
          "legendFormat": "{{cause}}"
        }
      ],
      "description": "Vacío hasta el primer GC después de arrancar: con 2 GB de heap, en una app con poco tráfico puede tardar."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Pausa máxima por causa",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 15,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (cause) (jvm_gc_pause_seconds_max{app=\"$app\"})",
          "legendFormat": "{{cause}}"
        }
      ],
      "description": "Peor pausa de la ventana deslizante de Micrometer (unos 2 minutos), no del rango del dashboard. Vacío hasta el primer GC."
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Overhead de GC",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jvm_gc_overhead{app=\"$app\"}",
          "legendFormat": "overhead"
        }
      ],
      "description": "Fracción del tiempo de CPU usada por el GC."
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Asignación y promoción",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 15,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(jvm_gc_memory_allocated_bytes_total{app=\"$app\"}[2m])",
          "legendFormat": "asignado"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(jvm_gc_memory_promoted_bytes_total{app=\"$app\"}[2m])",
          "legendFormat": "promovido a Old Gen"
        }
      ]
    },
    {
      "id": 15,
      "type": "row",
      "title": "Threads",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Threads por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (jvm_threads_states_threads{app=\"$app\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Clases cargadas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jvm_classes_loaded_classes{app=\"$app\"}",
          "legendFormat": "cargadas"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Archivos abiertos",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_files_open_files{app=\"$app\"}",
          "legendFormat": "abiertos"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_files_max_files{app=\"$app\"}",
          "legendFormat": "máximo"
        }
      ]
    },
    {
      "id": 19,
      "type": "row",
      "title": "Recursos",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Pool de la base",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_active{app=\"$app\"})",
          "legendFormat": "active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_idle{app=\"$app\"})",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_pending{app=\"$app\"})",
          "legendFormat": "pending"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(hikaricp_connections_max{app=\"$app\"})",
          "legendFormat": "max"
        }
      ],
      "description": "Conexiones de Hikari. Pending > 0 sostenido: el pool no alcanza o la base no responde. Vacío hasta la primera consulta a la base."
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Timeouts del pool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 33,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(hikaricp_connections_timeout_total{app=\"$app\"}[5m]))",
          "legendFormat": "timeouts"
        }
      ],
      "description": "Pedidos de conexión que vencieron esperando una libre (últimos 5 minutos)."
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Executors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 33,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (executor_active_threads{app=\"$app\"})",
          "legendFormat": "{{name}} activos"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (name) (executor_queued_tasks{app=\"$app\"})",
          "legendFormat": "{{name}} en cola"
        }
      ]
    }
  ]
}
