{
  "uid": "cliente",
  "title": "Cliente",
  "tags": [
    "cobre"
  ],
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Cliente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(notificator_deliveries_total, client_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(notificator_deliveries_total, client_id)",
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Tasa de éxito",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(notificator_deliveries_total{outcome=\"delivered\", client_id=\"$client\"}[$__range])) / sum(increase(notificator_deliveries_total{outcome=~\"delivered|failed\", client_id=\"$client\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "description": "DELIVERED / (DELIVERED + FAILED) del cliente en el rango elegido.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Volumen por resultado (por minuto)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(notificator_deliveries_total{client_id=\"$client\"}[2m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Intentos fallidos por código",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (increase(notificator_webhook_attempts_total{client_id=\"$client\", outcome!=\"delivered\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "description": "Código HTTP o error de transporte (timeout, connect_error, io_error)."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia p95 del webhook",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(notificator_webhook_latency_seconds_bucket{client_id=\"$client\"}[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Respuestas del webhook por código (por minuto)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "2.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "3.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "4.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "5.."
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(notificator_webhook_attempts_total{client_id=\"$client\", status=~\"[0-9]+\"}[2m])) * 60",
          "legendFormat": "{{status}}"
        }
      ],
      "description": "Códigos HTTP que respondió el webhook del cliente, éxitos incluidos. Solo llamadas con respuesta: los timeouts, errores de conexión y rechazos del circuito están en \"Intentos fallidos por código\"."
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Estado del circuito",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Cerrado",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Abierto",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "always",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(resilience4j_circuitbreaker_state{name=\"$client\", state=~\"open|forced_open|half_open\"})",
          "legendFormat": "Circuito"
        }
      ],
      "description": "Estado del circuit breaker del cliente, leído en cada scrape (15 s). Semiabierto cuenta como abierto: dura lo que tarda la prueba al webhook (milisegundos), así que con este muestreo no se ve. Las pruebas y aperturas exactas están en el panel de al lado."
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Circuito en el rango",
      "description": "Sobre el rango elegido. Tiempo abierto: suma de los scrapes en que el circuito no estaba cerrado. Veces que se abrió: pasos de cerrado a abierto. Pruebas al webhook: cada intento de cerrarlo tras la espera (cada 30 s mientras está abierto); salen del log \"Circuit state changed\".",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "expr": "sum_over_time(max(resilience4j_circuitbreaker_state{name=\"$client\", state=~\"open|forced_open|half_open\"})[$__range:15s]) * 15 or vector(0)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({app=\"notificator\"} | json | message=\"Circuit state changed\" | client_id=\"$client\" | from=\"CLOSED\" | to=\"OPEN\" [$__range])) or vector(0)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "queryType": "instant",
          "expr": "sum(count_over_time({app=\"notificator\"} | json | message=\"Circuit state changed\" | client_id=\"$client\" | to=\"HALF_OPEN\" [$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Tiempo abierto"
              },
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Veces que se abrió"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Pruebas al webhook"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "wideLayout": true,
        "text": {
          "titleSize": 14,
          "valueSize": 28
        }
      }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Intentos fallidos",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{app=\"notificator\"} | json | client_id=\"$client\" | message=~\"Delivery attempt failed.*|Event failed.*|Message in DLT|Stale last attempt failed\" | line_format `{{.message}} event_id={{.event_id}}{{with .attempt}} attempt={{.}}{{end}}{{with .error}} error={{.}}{{end}}`"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
