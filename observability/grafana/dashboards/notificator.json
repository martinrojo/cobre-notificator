{
  "uid": "notificator",
  "title": "Notificator",
  "tags": [
    "cobre"
  ],
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "editable": false,
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Intentos al webhook por resultado (por minuto)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(notificator_webhook_attempts_total[2m])) * 60",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Intentos por número de intento",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (attempt, outcome) (increase(notificator_webhook_attempts_total[$__range]))",
          "legendFormat": "intento {{attempt}} · {{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Intentos ejecutados en el rango elegido, por número de intento (1 a 4) y resultado.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Estados finales",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(notificator_deliveries_total{outcome=~\"delivered|failed|not_subscribed\"}[$__range]))",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "range": false
        }
      ],
      "description": "Eventos que terminaron en DELIVERED, FAILED o NOT_SUBSCRIBED en el rango elegido.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tasa de NOT_SUBSCRIBED",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 4,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(notificator_deliveries_total{outcome=\"not_subscribed\"}[$__range])) or vector(0)) / sum(increase(notificator_deliveries_total{outcome=~\"delivered|failed|not_subscribed\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Escrituras con 0 filas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (increase(notificator_discarded_total[5m]))",
          "legendFormat": "{{reason}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(notificator_replays_total{outcome=\"discarded\"}[5m]))",
          "legendFormat": "replay"
        }
      ],
      "description": "Escrituras condicionales que no afectaron filas: duplicados, intentos obsoletos, mensajes del DLT ignorados y replays descartados."
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Errores de persistencia vs errores del webhook (por minuto)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(notificator_persistence_errors_total[2m])) * 60 or vector(0)",
          "legendFormat": "persistencia (base)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(notificator_webhook_attempts_total{outcome!=\"delivered\"}[2m])) * 60 or vector(0)",
          "legendFormat": "webhook"
        }
      ],
      "description": "Persistencia: errores transitorios de la base reintentados en el mismo offset. Webhook: intentos con resultado retryable o permanent."
    }
  ]
}
