{
  "info": {
    "name": "webhook-mock",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "clientId",
      "value": "CLIENT002"
    }
  ],
  "item": [
    {
      "name": "Config",
      "item": [
        {
          "name": "Ver configuración",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config"
              ]
            }
          }
        },
        {
          "name": "Default 200 sin demora (reset)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 200, \"delay_ms\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Default 500 tras 2 s",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 500, \"delay_ms\": 2000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cliente 503 (reintenta)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config",
                "clients",
                "{{clientId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 503, \"delay_ms\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cliente 429 (reintenta)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config",
                "clients",
                "{{clientId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 429, \"delay_ms\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cliente 400 (FAILED sin reintentos)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config",
                "clients",
                "{{clientId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 400, \"delay_ms\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cliente lento 2 s",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config",
                "clients",
                "{{clientId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 200, \"delay_ms\": 2000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cliente timeout 15 s",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config",
                "clients",
                "{{clientId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 200, \"delay_ms\": 15000}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reset cliente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/config/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config",
                "clients",
                "{{clientId}}"
              ]
            }
          }
        },
        {
          "name": "Validación 400 (status inválido)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": 99, \"delay_ms\": 0}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Webhook como el notificator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Event-Id",
                "value": "EVT999"
              },
              {
                "key": "X-Delivery-Attempt",
                "value": "1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "{{clientId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"event_id\": \"EVT999\", \"client_id\": \"{{clientId}}\", \"event_type\": \"credit_deposit\", \"content\": \"test\", \"created_at\": \"2026-10-12T10:00:00Z\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Entrega cruzada (log ERROR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/webhooks/CLIENT001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "CLIENT001"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"event_id\": \"EVT998\", \"client_id\": \"CLIENT002\", \"event_type\": \"credit_deposit\", \"content\": \"test\", \"created_at\": \"2026-10-12T10:00:00Z\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
